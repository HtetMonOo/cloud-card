@model CloudCart.Api.DTOs.OrderDto

@{
    ViewData["Title"] = "Order Details";
}

<h1>Order #@Model.Id</h1>

<dl class="row">
    <dt class="col-sm-2">User Id</dt>
    <dd class="col-sm-10">@Model.UserId</dd>

    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Model.CreatedAt</dd>

    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.Total.ToString("C")</dd>
</dl>

<h3>Items</h3>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Unit</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var it in Model.Items)
    {
        <tr>
            <td>@it.ProductName (@it.ProductId)</td>
            <td>@it.Quantity</td>
            <td>@it.UnitPrice.ToString("C")</td>
            <td>@((it.UnitPrice * it.Quantity).ToString("C"))</td>
        </tr>
    }
    </tbody>
</table>

<p>
    <a class="btn btn-secondary" href="/">Home</a>
</p>
