@model List<CloudCart.Api.DTOs.UserDto>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>
    <a class="btn btn-primary" href="/Users/Create">Create New User</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Id</td>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td><a class="btn btn-sm btn-outline-secondary" href="/Users/Details/@u.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>
