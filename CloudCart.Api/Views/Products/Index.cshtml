@model List<CloudCart.Api.DTOs.ProductDto>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a class="btn btn-primary" href="/Products/Create">Create New Product</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@p.Price.ToString("C")</td>
            <td><a class="btn btn-sm btn-outline-secondary" href="/Products/Details/@p.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>
