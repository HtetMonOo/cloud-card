@model List<CloudCart.Api.DTOs.OrderDto>

@{
    ViewData["Title"] = "User Orders";
}

<h1>Orders for User @ViewBag.UserId</h1>

<table class="table">
    <thead>
        <tr>
            <th>Order Id</th>
            <th>Created</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.Id</td>
            <td>@o.CreatedAt</td>
            <td>@o.Total.ToString("C")</td>
            <td><a class="btn btn-sm btn-outline-secondary" href="/Orders/Details/@o.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>
